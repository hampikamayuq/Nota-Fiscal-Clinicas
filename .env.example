# Copie para .env (desenvolvimento) — nunca versione o .env.
# Em produção, o compose monta DATABASE_URL e lê o resto de .env.production (ver docs/deploy.md).

# Banco local (ver README para subir um PostgreSQL com docker)
DATABASE_URL=postgresql://fiscal:fiscal@127.0.0.1:5432/fiscal
DATABASE_URL_TEST=postgresql://fiscal:fiscal@127.0.0.1:5432/fiscal_test

# Nome da clínica na interface ("<nome> Fiscal") e na aba do navegador.
CLINIC_NAME=Minha Clínica

# Assina o cookie de sessão (mínimo 32 caracteres). Gere com: openssl rand -base64 48
AUTH_SECRET=

API_HOST=127.0.0.1
API_PORT=3100

# Provedor fiscal: fake (desenvolvimento; nada é emitido) ou focus (Focus NFe, NFS-e nacional).
FISCAL_PROVIDER=fake

# Focus NFe. Produção exige FOCUS_ENV=production, ALLOW_PRODUCTION_EMISSION=true
# e a empresa ligada por um ADMIN na tela Empresas — as três ao mesmo tempo.
FOCUS_ENV=homologation
ALLOW_PRODUCTION_EMISSION=false
# Um token por empresa (pasta em empresas/) e por ambiente: slug em maiúsculas, hífen vira sublinhado.
# FOCUS_TOKEN_HOMOLOGACAO_MINHA_CLINICA=
# FOCUS_TOKEN_PRODUCAO_MINHA_CLINICA=
# Valor que a Focus manda no cabeçalho Authorization do webhook. Gere com: openssl rand -hex 32
# FOCUS_WEBHOOK_SECRET=

# Pasta das empresas (padrão ./empresas)
# NFSE_EMPRESAS_DIR=./empresas
